# Copy this file to ".env" in the project root (next to README.md). Never commit .env or share real keys.

# --- Image classifier (required for /diagnose) ---
CLASSIFIER_MODEL_PATH=models/crop_disease.onnx
CLASSIFIER_LABELS_PATH=models/labels.json
CONFIDENCE_THRESHOLD=0.6

# --- AI provider: "groq" (default) or "huggingface" ---
LLM_PROVIDER=groq
GROQ_API_KEY=
# GROQ_MODEL=

# Hugging Face / Gemma (used when LLM_PROVIDER=huggingface)
# HF_TOKEN=
# HF_MODEL=
# HF_INFERENCE_PROVIDER=auto
# DIAGNOSE_USE_VISION=true

# --- App behaviour ---
DEMO_MODE=false
AUTH_REQUIRED=true
APP_ENV=development
# SESSION_DAYS=14
# SESSION_COOKIE_SECURE=false
# SUPERVISOR_ACCESS_TOKEN=
